program SpriteAnimation;

const
    PlayerMinimumX: byte = $0C;
    PlayerMaximumX: byte = $F4;
    PlayerMinimumY: byte = $0D;
    PlayerMaximumY: byte = $E4;

var
    Player: metasprite;
    PlayerX: byte;
    PlayerY: byte;
    PlayerHidden: boolean;
    Moving: boolean;

procedure Update;
begin
    Moving := false;

    if nes.controller_down($01, nes.button_left) then
    begin
        if PlayerX > PlayerMinimumX then
            dec(PlayerX);
        nes.metasprite_set_flip_horizontal(Player, true);
        Moving := true;
    end
    else if nes.controller_down($01, nes.button_right) then
    begin
        if PlayerX < PlayerMaximumX then
            inc(PlayerX);
        nes.metasprite_set_flip_horizontal(Player, false);
        Moving := true;
    end;

    if nes.controller_down($01, nes.button_up) then
    begin
        if PlayerY > PlayerMinimumY then
            dec(PlayerY);
        Moving := true;
    end
    else if nes.controller_down($01, nes.button_down) then
    begin
        if PlayerY < PlayerMaximumY then
            inc(PlayerY);
        Moving := true;
    end;

    if Moving then
        nes.metasprite_set_animation(Player, player.movement_right)
    else
        nes.metasprite_set_animation(Player, player.idle);

    if nes.controller_pressed($01, nes.button_a) then
        nes.metasprite_restart_animation(Player);

    if nes.controller_pressed($01, nes.button_select) then
    begin
        PlayerHidden := not PlayerHidden;
        if PlayerHidden then
            nes.metasprite_hide(Player)
        else
            nes.metasprite_show(Player);
    end;

    nes.metasprite_set_position(Player, PlayerX, PlayerY);
end;

begin
    nes.import_metasprite(player);
    Player := nes.metasprite_create(player.idle_0);
    PlayerX := $70;
    PlayerY := $68;
    PlayerHidden := false;
    Moving := false;

    nes.set_background_color($0F);
    nes.set_sprite_palette($00, $0F, $16, $27, $30);
    nes.metasprite_set_position(Player, PlayerX, PlayerY);
    nes.metasprite_set_animation(Player, player.idle);
    nes.metasprite_show(Player);
    nes.on_update(Update);
    nes.run;
end.
