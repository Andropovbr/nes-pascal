program MetaspriteClipping;

const
    CenterX: byte = $70;
    CenterY: byte = $68;
    PartlyBeyondLeftX: byte = $08;
    PartlyBeyondRightX: byte = $F8;
    PartlyBeyondTopY: byte = $08;
    PartlyBeyondBottomY: byte = $EC;

var
    Player: metasprite;
    Stage: byte;
    PlayerX: byte;
    PlayerY: byte;

begin
    nes.import_metasprite(player);
    Player := nes.metasprite_create(player.idle_0);
    Stage := $00;
    PlayerX := CenterX;
    PlayerY := CenterY;
    nes.set_sprite_palette($00, $0F, $16, $27, $30);
    nes.metasprite_set_flip_horizontal(Player, false);
    nes.metasprite_set_flip_vertical(Player, false);
    nes.metasprite_set_position(Player, PlayerX, PlayerY);
    nes.metasprite_show(Player);
    nes.set_background_color($0F);
    nes.run;

    while true do
    begin
        nes.wait_frame;
        if Stage = $00 then
        begin
            nes.metasprite_set_flip_horizontal(Player, false);
            nes.metasprite_set_flip_vertical(Player, false);
            if PlayerX > PartlyBeyondLeftX then
                dec(PlayerX)
            else
                Stage := $01;
            nes.metasprite_set_position(Player, PlayerX, PlayerY);
            nes.metasprite_show(Player);
        end
        else if Stage = $01 then
        begin
            nes.metasprite_set_flip_horizontal(Player, false);
            nes.metasprite_set_flip_vertical(Player, false);
            if PlayerX < CenterX then
                inc(PlayerX)
            else
                Stage := $02;
            nes.metasprite_set_position(Player, PlayerX, PlayerY);
            nes.metasprite_show(Player);
        end
        else if Stage = $02 then
        begin
            nes.metasprite_set_flip_horizontal(Player, false);
            nes.metasprite_set_flip_vertical(Player, false);
            if PlayerX < PartlyBeyondRightX then
                inc(PlayerX)
            else
                Stage := $03;
            nes.metasprite_set_position(Player, PlayerX, PlayerY);
            nes.metasprite_show(Player);
        end
        else if Stage = $03 then
        begin
            nes.metasprite_set_flip_horizontal(Player, false);
            nes.metasprite_set_flip_vertical(Player, false);
            if PlayerX > CenterX then
                dec(PlayerX)
            else
                Stage := $04;
            nes.metasprite_set_position(Player, PlayerX, PlayerY);
            nes.metasprite_show(Player);
        end
        else if Stage = $04 then
        begin
            nes.metasprite_set_flip_horizontal(Player, false);
            nes.metasprite_set_flip_vertical(Player, false);
            if PlayerY > PartlyBeyondTopY then
                dec(PlayerY)
            else
                Stage := $05;
            nes.metasprite_set_position(Player, PlayerX, PlayerY);
            nes.metasprite_show(Player);
        end
        else if Stage = $05 then
        begin
            nes.metasprite_set_flip_horizontal(Player, false);
            nes.metasprite_set_flip_vertical(Player, false);
            if PlayerY < CenterY then
                inc(PlayerY)
            else
                Stage := $06;
            nes.metasprite_set_position(Player, PlayerX, PlayerY);
            nes.metasprite_show(Player);
        end
        else if Stage = $06 then
        begin
            nes.metasprite_set_flip_horizontal(Player, false);
            nes.metasprite_set_flip_vertical(Player, false);
            if PlayerY < PartlyBeyondBottomY then
                inc(PlayerY)
            else
                Stage := $07;
            nes.metasprite_set_position(Player, PlayerX, PlayerY);
            nes.metasprite_show(Player);
        end
        else
        begin
            nes.metasprite_set_flip_horizontal(Player, false);
            nes.metasprite_set_flip_vertical(Player, false);
            if PlayerY > CenterY then
                dec(PlayerY)
            else
                Stage := $00;
            nes.metasprite_set_position(Player, PlayerX, PlayerY);
            nes.metasprite_show(Player);
        end;
    end;
end.
