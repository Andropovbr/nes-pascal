program Enumerations;

type
    GameState = (Title, Playing, Paused, GameOver);

var
    State: GameState;
    Previous: GameState;
    Enabled: boolean;
    StoredEqual: boolean;

begin
    State := Title;
    Previous := Playing;
    State := Previous;
    Enabled := State <> Paused;
    StoredEqual := State = Playing;

    if State = Playing then
        State := GameOver;

    nes.set_background_color($0F);
    nes.run;
end.
